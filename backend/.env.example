# Point at a Postgres database you've created yourself (this project doesn't run its own DB container).
# This file is only used when running the backend directly (npm run dev) — Docker gets its
# DATABASE_URL from the repo root's .env instead (see README.md).
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<your-db-name>?schema=public"
JWT_SECRET="change-this-in-real-deployments"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
